APP_NAME="DigitHub Connect"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=it
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=it_IT

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=file
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=file
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# In sviluppo "log" scrive le email in storage/logs/laravel.log.
# In produzione: MAIL_MAILER=smtp con le credenziali del provider.
MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
# Il mittente deve stare su un dominio nostro, autenticato SPF/DKIM: il nome
# visualizzato diventa quello del portale, e il Reply-To la sua email.
MAIL_FROM_ADDRESS="notifiche@digithub.test"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# DigitHub License Manager (read-only licence API). Server side only: the key never goes to the browser.
# Use a different software and key for each environment. LICENSE_ENFORCEMENT: off | observe | on.
LICENSE_API_URL=
LICENSE_API_KEY=
LICENSE_SOFTWARE_CODE=
LICENSE_ENFORCEMENT=off
LICENSE_CACHE_TTL_SECONDS=300
LICENSE_OFFLINE_GRACE_HOURS=72
LICENSE_SUPPORT_EMAIL=

# --- Passkey (accesso con impronta, volto o chiave di sicurezza) ---
# false (default): nascoste del tutto. Niente pulsante nel login, niente sezione in Sicurezza,
# nessuna rotta. L'accesso protetto resta la 2FA con l'app di autenticazione.
# true: le riattiva. Richiede https in produzione e APP_URL col dominio vero.
PASSKEYS_ENABLED=false
